# Optional for public t.me/s crawling. Required only when using Bot API chat_id sources.
TELEGRAM_BOT_TOKEN=
DATABASE_URL=sqlite:///./data/telegram_forwarder.db
TIMEZONE=Asia/Shanghai
CRAWL_INTERVAL_SECONDS=300
GROUPS_CONFIG_PATH=config/groups.yaml
ADMIN_API_KEY=
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=true
APP_ENV=production
APP_UID=1000
APP_GID=1000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SOURCE_STALE_AFTER_SECONDS=900
MEDIA_CACHE_DIR=./data/media-cache

# GitHub 排行榜。令牌可选，但生产环境建议配置 fine-grained token（只需公开仓库只读权限）。
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_REFRESH_INTERVAL_SECONDS=1800
GITHUB_LANGUAGES=Python,JavaScript,TypeScript,Java,Go,Rust,C++,C#,PHP,Swift,Kotlin,Ruby
GITHUB_CANDIDATES_PER_LANGUAGE=30
GITHUB_MIN_STARS=20

# 可选：为 GitHub 仓库生成中文项目解读。兼容 OpenAI Chat Completions 接口。
# 未启用或调用失败时，排行榜仍展示 GitHub 原始简介与主语言。
GITHUB_AI_ENABLED=false
GITHUB_AI_API_KEY=
GITHUB_AI_BASE_URL=https://api.openai.com/v1
GITHUB_AI_MODEL=
GITHUB_AI_TIMEOUT_SECONDS=45
GITHUB_AI_REPOSITORIES_PER_REFRESH=6
