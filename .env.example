# Comments must sit on their own line: the loader does not strip trailing "# ..." from a value.

# ---------------------------------------------------------------------------
# Security. The service refuses to start in production when these are weak.
# ---------------------------------------------------------------------------
# production | staging | development | test  (case-insensitive; anything else is refused)
APP_ENV=production
# Admin login key, at least 16 characters:   openssl rand -hex 24
ADMIN_API_KEY=
# Session HMAC key, at least 32 bytes:       openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Must be true when APP_ENV=production (the cookie is then only sent over HTTPS).
SESSION_COOKIE_SECURE=true
# Failed admin logins allowed per client within the window, then HTTP 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Feedback submissions allowed per client within the window, then HTTP 429.
FEEDBACK_RATE_LIMIT=5
FEEDBACK_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Listen address. Empty = all interfaces (needed inside Docker); use 127.0.0.1 to listen locally only.
HOST=
PORT=8000
# Reverse proxies whose X-Forwarded-For / X-Real-IP headers are believed, as a
# comma-separated list of IPs / CIDRs, or: private (default: loopback + private
# ranges, which covers a proxy on the same host or Docker network), loopback, none.
# Requests from any other address are identified by their TCP address and their
# forwarding headers are ignored. The proxy must also pass the original Host header.
TRUSTED_PROXIES=private

# ---------------------------------------------------------------------------
# Data and collection
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/telegram_forwarder.db
TIMEZONE=Asia/Shanghai
CRAWL_INTERVAL_SECONDS=300
SOURCE_STALE_AFTER_SECONDS=900
# Seeded into the sources table once, while it is empty.
GROUPS_CONFIG_PATH=config/groups.yaml

# ---------------------------------------------------------------------------
# Media cache
# ---------------------------------------------------------------------------
MEDIA_CACHE_DIR=./data/media-cache
# Only https URLs on these hosts (and their subdomains) are ever downloaded.
# Default: telesco.pe,cdn-telegram.org
MEDIA_ALLOWED_HOSTS=
# Largest single file the cache will store (bytes). Default 100663296 (96 MiB).
MEDIA_MAX_BYTES=

# ---------------------------------------------------------------------------
# Docker build arguments (docker-compose.yml)
# ---------------------------------------------------------------------------
APP_UID=1000
APP_GID=1000

# Not used by the Go service (the Bot API adapter was not carried over); kept so
# an existing .env keeps loading.
TELEGRAM_BOT_TOKEN=
